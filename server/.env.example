# LocalMuse Ops - Persistent Node.js Backend Environment Configuration
# Copy this file to .env or set environment variables in your deployment platform (Railway / Render)
# Do NOT commit .env or paste real Qloo credentials into client code or version control

# Server Network Configuration
PORT=4000
NODE_ENV=development
FRONTEND_ORIGIN="http://localhost:3000"

# Qloo MCP & API Credentials (Backend Only)
# When QLOO_API_KEY is unset, the system safely and transparently operates in Demo Mode
QLOO_API_KEY=""

# Path to qloo executable (defaults to "qloo" in system PATH)
QLOO_BIN_PATH="qloo"

# Optional custom directory for Qloo CLI state / configuration
QLOO_HOME=""

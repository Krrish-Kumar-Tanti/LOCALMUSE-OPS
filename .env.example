# LocalMuse Ops - Environment Configuration Template
# Copy this file to .env.local and populate with your credentials.
# Do NOT commit .env.local or any real credentials to version control.

# Application Environment
NEXT_PUBLIC_APP_NAME="LocalMuse Ops"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Qloo API Configuration
# Obtain your API key from the Qloo Developer Portal: https://developer.qloo.com
QLOO_API_KEY=""
QLOO_API_BASE_URL="https://api.qloo.com"

# Optional / Future Services
# DATABASE_URL=""
# NEXTAUTH_SECRET=""
# NEXTAUTH_URL="http://localhost:3000"
